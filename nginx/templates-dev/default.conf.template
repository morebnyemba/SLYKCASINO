# =============================================================================
#  SLYK CASINO — Nginx gateway (LOCAL DEV, HTTP only, no TLS / no certbot)
#  Used by docker-compose.override.yml. Same routing as production.
# =============================================================================

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Docker's embedded DNS. A container gets a new IP whenever it's recreated
# (`docker compose up -d django` after a deploy), and a static `upstream {}`
# block keeps the address it looked up at startup — every request would then
# 502 until nginx restarted. Each proxy_pass below names its service through
# a variable instead, which nginx resolves through this resolver (cached for
# `valid`), so it follows recreated containers on its own and boots even if
# one isn't up yet.
resolver 127.0.0.11 valid=10s ipv6=off;


proxy_set_header Host              $host;
proxy_set_header X-Real-IP         $remote_addr;
proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;

server {
    listen 80;
    server_name ${DOMAIN};
    client_max_body_size 25m;

    # Django REST API
    location /api/ {
        set $django_upstream django:8000;
        proxy_pass http://$django_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
    }

    # Django admin (raw DB intervention)
    location /django-admin/ {
        set $django_upstream django:8000;
        proxy_pass http://$django_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
    }

    # Django admin static assets (WhiteNoise).
    location /django-static/ {
        set $django_upstream django:8000;
        proxy_pass http://$django_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
    }

    # Erlang realtime WebSocket
    location /ws/ {
        set $erlang_upstream erlang:8080;
        proxy_pass http://$erlang_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host       $host;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }

    # Next.js Admin UI (basePath /admin-portal). Upgrade headers => HMR works.
    location /admin-portal {
        set $admin_upstream admin_frontend:3000;
        proxy_pass http://$admin_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host       $host;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    # Next.js Player UI (root). Upgrade headers => HMR works.
    location / {
        set $player_upstream player_frontend:3000;
        proxy_pass http://$player_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host       $host;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}
