# =============================================================================
#  SLYK CASINO — Production Environment Variables
#  Copy this file to .env.prod and fill in real values.
#  NEVER commit .env.prod to version control.
# =============================================================================

# --- Domain ---
DOMAIN=yourdomain.com
# Let's Encrypt account email (init-letsencrypt.sh)
CERTBOT_EMAIL=admin@yourdomain.com

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-50-char-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# Django superuser (created on first boot if set)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@yourdomain.com
DJANGO_SUPERUSER_PASSWORD=change-me

# --- Database ---
# DATABASE_URL is derived automatically (backend/config/settings.py) from the
# three vars below — set these and Django/Celery connect to the same
# credentials Postgres actually gets. Do not add a DATABASE_URL line here;
# it would silently override the derived one and can drift out of sync.
POSTGRES_DB=slyk_prod
POSTGRES_USER=slyk
POSTGRES_PASSWORD=change-me

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-sendgrid-api-key
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
FRONTEND_URL=https://yourdomain.com

# --- Geo-blocking ---
BLOCKED_COUNTRIES=US,FR,AU,SG,HK

# --- Realtime (live odds) ---
# Set to true once the erlang service is deployed to enable live odds publishing.
REALTIME_PUBLISH_ENABLED=true
REALTIME_PUBLISH_URL=http://erlang:8080/publish

# --- api-football.com (game/fixture updates) ---
# https://www.api-football.com/documentation-v3 — leave blank to disable sync.
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
# Also offer bet types the importer doesn't recognise (settled manually in admin).
# Everything recognised — incl. corners, cards, goalscorers — settles automatically.
SPORTSBOOK_IMPORT_MANUAL_MARKETS=false
# In-play betting from api-football /odds/live (your plan must include live odds).
# Polls every SPORTSBOOK_LIVE_ODDS_INTERVAL seconds while a match could be live
# (~10k requests/day at 8s); prices older than SPORTSBOOK_LIVE_ODDS_STALE seconds
# suspend betting; in-play bets confirm after SPORTSBOOK_LIVE_BET_DELAY seconds.
SPORTSBOOK_LIVE_BETTING=true
SPORTSBOOK_LIVE_ODDS_INTERVAL=8
SPORTSBOOK_LIVE_ODDS_STALE=30
SPORTSBOOK_LIVE_BET_DELAY=6

# Affiliate programme defaults (per-affiliate terms are editable in the admin portal).
# Revenue share = % of referred players' monthly net gaming revenue; CPA = one-off
# per referral once their deposits reach the minimum (0 = off).
AFFILIATE_DEFAULT_REVSHARE=25
AFFILIATE_DEFAULT_CPA=0
AFFILIATE_DEFAULT_CPA_MIN_DEPOSIT=20
AFFILIATE_AUTO_APPROVE=false
AFFILIATE_AUTO_PAY=false

# Payments: stub credits deposits instantly with no money moving — use paynow in production.
PSP_PROVIDER=paynow
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_AUTH_EMAIL=
# Optional multi-bet bonus rules (tiers are edited in the Django admin).
SPORTSBOOK_ACCA_BONUS_MIN_ODDS=1.20
SPORTSBOOK_ACCA_BONUS_CAP=1000
